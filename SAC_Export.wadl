						<doc xml:lang="en" title="delimiter Parameter">If included when the format is set to text/csv, will adjust the delimiter to the value passed here.</doc>
					</param>
				</request>
				<response status="200">
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
