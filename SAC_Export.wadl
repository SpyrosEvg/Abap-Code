			<param name="namespaceID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="namespaceID Parameter">Possible value 'sac_public_dimensions' representing public dimensions in SAP Analytics Cloud.</doc>
