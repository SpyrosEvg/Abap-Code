<application xmlns="http://wadl.dev.java.net/2009/02">
	<doc xml:lang="en" title="Data Export Service">The Data Export Service is an open API that enables the export of fact, master and audit data from models as well as currency, unit conversion and public dimension data from SAP Analytics Cloud.</doc>
	<resources base="/api/v1/dataexport">
		<resource path="administration/Namespaces" id="/administration/Namespaces">
			<doc xml:lang="en" title="/administration/Namespaces"/>
			<method name="GET" id="getNameSpaces">
				<doc xml:lang="en" title="getNameSpaces">This endpoint allows you to view a list of namespaces. A namespace corresponds to an SAP Analytics Cloud system.
Returns all namespaces (API providers) that the user has permissions to use.</doc>
				<request>
					<param name="$filter" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="$filter Parameter">Filter result set according to the filter string. For example, MyColumn1 eq 'sac'.</doc>
					</param>
				</request>
				<response status="200">
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
					<representation mediaType="application/json"/>
				</response>
				<response status="404">
					<representation mediaType="application/json"/>
				</response>
				<response status="500">
					<representation mediaType="application/json"/>
				</response>
			</method>
		</resource>
		<resource path="administration/$metadata" id="/administration/$metadata">
			<doc xml:lang="en" title="/administration/$metadata"/>
			<method name="GET" id="getMetadata">
				<doc xml:lang="en" title="getMetadata">This endpoint returns the OData EDMX document for the administration service.
Returns the metadata document for the administration service.</doc>
				<request>
					<param name="$format" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="$format Parameter">The format of the response to return. For example, $format=application/json. If empty defaults to application/xml.</doc>
					</param>
				</request>
				<response status="200">
					<representation mediaType="application/xml"/>
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/xml"/>
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
					<representation mediaType="application/xml"/>
					<representation mediaType="application/json"/>
				</response>
				<response status="404">
					<representation mediaType="application/xml"/>
					<representation mediaType="application/json"/>
				</response>
				<response status="500">
					<representation mediaType="application/xml"/>
					<representation mediaType="application/json"/>
				</response>
			</method>
		</resource>
		<resource path="administration/Namespaces(NamespaceID='{NamespaceID}')" id="/administration/Namespaces(NamespaceID='{NamespaceID}')">
			<doc xml:lang="en" title="/administration/Namespaces(NamespaceID='{NamespaceID}')"/>
			<param name="NamespaceID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="NamespaceID Parameter">Possible value 'sac' representing SAP Analytics Cloud, 'sac_currency_tables' representing currency tables in SAP Analytics Cloud, or 'sac_unit_conversion' representing unit conversion tables in SAP Analytics Cloud, or 'sac_public_dimensions' representing public dimensions in SAP Analytics Cloud.</doc>
			</param>
			<method name="GET" id="getNamespaceById">
				<doc xml:lang="en" title="getNamespaceById">This endpoint allows you to view the selected NamespaceID and associated description.
Returns a namespace (API Provider) by ID.</doc>
				<request/>
				<response status="200">
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
					<representation mediaType="application/json"/>
				</response>
				<response status="404">
					<representation mediaType="application/json"/>
				</response>
				<response status="500">
					<representation mediaType="application/json"/>
				</response>
			</method>
		</resource>
		<resource path="administration/Namespaces(NamespaceID='{NamespaceID}')/Providers" id="/administration/Namespaces(NamespaceID='{NamespaceID}')/Providers">
			<doc xml:lang="en" title="/administration/Namespaces(NamespaceID='{NamespaceID}')/Providers"/>
			<param name="NamespaceID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="NamespaceID Parameter">This endpoint allows you to view all the providers available for the specified namespace. In this context, a provider corresponds with a model which is available on an SAP Analytics Cloud system. In the context of 'sac_currency_tables' namespace, a provider corresponds to a currency table. In the context of 'sac_unit_conversion' namespace, a provider corresponds to a unit conversion table.In the context of 'sac_public_dimensions' namespace, a provider corresponds to a public dimension.</doc>
			</param>
			<method name="GET" id="getNamespaceProviders">
				<doc xml:lang="en" title="getNamespaceProviders">This endpoint allows you to view all the providers available for the specified namespace. In this context, a provider corresponds with a model which is available on an SAP Analytics Cloud system. In the context of 'sac_currency_tables' namespace, a provider corresponds to a currency table. In the context of 'sac_unit_conversion' namespace, a provider corresponds to a unit conversion table.In the context of 'sac_public_dimensions' namespace, a provider corresponds to a public dimension.
Returns providers of a certain namespace. For example, planning models on the SAP Analytics Cloud system.</doc>
				<request/>
				<response status="200">
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
					<representation mediaType="application/json"/>
				</response>
				<response status="404">
					<representation mediaType="application/json"/>
				</response>
				<response status="500">
					<representation mediaType="application/json"/>
				</response>
			</method>
		</resource>
		<resource path="administration/Subscriptions" id="/administration/Subscriptions">
			<doc xml:lang="en" title="/administration/Subscriptions"/>
			<method name="GET" id="getAllSubscriptions">
				<doc xml:lang="en" title="getAllSubscriptions">This endpoint can be used to get all subscriptions present on a tenant.
Returns all subscriptions.</doc>
				<request/>
				<response status="200">
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
					<representation mediaType="application/json"/>
				</response>
				<response status="404">
					<representation mediaType="application/json"/>
				</response>
				<response status="500">
					<representation mediaType="application/json"/>
				</response>
				<response status="">
					<representation mediaType="application/json"/>
				</response>
			</method>
			<method name="POST" id="postSubscription">
				<doc xml:lang="en" title="postSubscription">This endpoint allows you to create a new subscription, specifically changing certain parameters, e.g NamespaceID, ProviderID, EntitySetName, and ExternalID.
Creates a new subscription, in order to track changes to an entity set. For example, Fact Data for a planning model on the SAP Analytics Cloud system.</doc>
				<request>
					<param name="x-csrf-token" type="xs:string" required="true" default="" style="header" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="x-csrf-token Parameter">Mandatory x-csrf-token that can be obtained by sending a GET request to &lt;tenant-url>/api/v1/csrf with the header parameter x-csrf-token:fetch.</doc>
					</param>
					<representation mediaType="application/json"/>
					<representation mediaType="application/json"/>
				</request>
				<response status="">
					<representation mediaType="application/json"/>
					<representation mediaType="application/json"/>
				</response>
				<response status="201">
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
					<representation mediaType="application/json"/>
				</response>
				<response status="404">
					<representation mediaType="application/json"/>
				</response>
				<response status="500">
					<representation mediaType="application/json"/>
				</response>
			</method>
		</resource>
		<resource path="administration/Providers(NamespaceID='{NamespaceID}',ProviderID='{ProviderID}')/Subscriptions" id="/administration/Providers(NamespaceID='{NamespaceID}',ProviderID='{ProviderID}')/Subscriptions">
			<doc xml:lang="en" title="/administration/Providers(NamespaceID='{NamespaceID}',ProviderID='{ProviderID}')/Subscriptions"/>
			<param name="NamespaceID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="NamespaceID Parameter">Possible value 'sac' representing SAP Analytics Cloud.</doc>
			</param>
			<param name="ProviderID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="ProviderID Parameter">ID of a model from the SAP Analytics Cloud system.</doc>
			</param>
			<method name="GET" id="getSubscriptions">
				<doc xml:lang="en" title="getSubscriptions">This endpoint returns subscriptions for a given namespaceID and providerID.
Returns subscriptions for given namespaceID and providerID.</doc>
				<request/>
				<response status="200">
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
					<representation mediaType="application/json"/>
				</response>
				<response status="404">
					<representation mediaType="application/json"/>
				</response>
				<response status="500">
					<representation mediaType="application/json"/>
				</response>
			</method>
		</resource>
		<resource path="administration/Subscriptions(NamespaceID='{NamespaceID}',ProviderID='{ProviderID}',SubscriptionID='{SubscriptionID}')" id="/administration/Subscriptions(NamespaceID='{NamespaceID}',ProviderID='{ProviderID}',SubscriptionID='{SubscriptionID}')">
			<doc xml:lang="en" title="/administration/Subscriptions(NamespaceID='{NamespaceID}',ProviderID='{ProviderID}',SubscriptionID='{SubscriptionID}')"/>
			<param name="NamespaceID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="NamespaceID Parameter">Possible value 'sac' representing SAP Analytics Cloud.</doc>
			</param>
			<param name="ProviderID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="ProviderID Parameter">ID of a model from the SAP Analytics Cloud system.</doc>
			</param>
			<param name="SubscriptionID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="SubscriptionID Parameter">The ID of the subscription to be deleted.</doc>
			</param>
			<method name="GET" id="getSingleSubscription">
				<doc xml:lang="en" title="getSingleSubscription">This endpoint returns a single subscription based on the input parameters.
Returns a single subscription.</doc>
				<request/>
				<response status="200">
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
					<representation mediaType="application/json"/>
				</response>
				<response status="404">
					<representation mediaType="application/json"/>
				</response>
				<response status="500">
					<representation mediaType="application/json"/>
				</response>
			</method>
			<method name="DELETE" id="deleteSubscription">
				<doc xml:lang="en" title="deleteSubscription">This endpoint deletes a subscription matching the values entered for the fields. It can also delete an entire subscription chain given the correct parameter. When accessed via a 3-legged connection, only available to the DataAcquisitionUser, or a user with admin privileges.
Deletes a subscription or an entire chain of subscriptions.</doc>
				<request>
					<param name="x-csrf-token" type="xs:string" required="true" default="" style="header" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="x-csrf-token Parameter">Mandatory x-csrf-token that can be obtained by sending a GET request to &lt;tenant-url>/api/v1/csrf with the header parameter x-csrf-token:fetch.</doc>
					</param>
					<param name="deleteChain" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="deleteChain Parameter">Optional parameter that allows users to delete the entire chain of subscriptions.</doc>
					</param>
				</request>
				<response status="204">
					<representation mediaType="application/json"/>
					<representation mediaType="application/xml"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
					<representation mediaType="application/xml"/>
				</response>
				<response status="403">
					<representation mediaType="application/json"/>
					<representation mediaType="application/xml"/>
				</response>
				<response status="404">
					<representation mediaType="application/json"/>
					<representation mediaType="application/xml"/>
				</response>
				<response status="500">
					<representation mediaType="application/json"/>
					<representation mediaType="application/xml"/>
				</response>
			</method>
		</resource>
		<resource path="administration/Subscriptions(NamespaceID='{NamespaceID}',ProviderID='{ProviderID}',SubscriptionID='')" id="/administration/Subscriptions(NamespaceID='{NamespaceID}',ProviderID='{ProviderID}',SubscriptionID='')">
			<doc xml:lang="en" title="/administration/Subscriptions(NamespaceID='{NamespaceID}',ProviderID='{ProviderID}',SubscriptionID='')"/>
			<param name="NamespaceID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="NamespaceID Parameter">Possible value 'sac' representing SAP Analytics Cloud.</doc>
			</param>
			<param name="ProviderID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="ProviderID Parameter">ID of a model from the SAP Analytics Cloud system.</doc>
			</param>
			<method name="DELETE" id="deleteProviderSubscription">
				<doc xml:lang="en" title="deleteProviderSubscription">This endpoint deletes all subscriptions for a particular provider, for example if the planning model is dismissed, or not in use anymore. The query parameter deleteEntitySetName can be used to delete all subscriptions for the ProviderID, EntitySetName and NamespaceID. When accessed via a 3-legged connection, only available to users with admin privileges.
Deletes all subscriptions for a particular provider or subscriptions for a particular Entity Set Name under a provider.</doc>
				<request>
					<param name="x-csrf-token" type="xs:string" required="true" default="" style="header" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="x-csrf-token Parameter">Mandatory x-csrf-token that can be obtained by sending a GET request to &lt;tenant-url>/api/v1/csrf with the header parameter x-csrf-token:fetch.</doc>
					</param>
					<param name="deleteEntitySetName" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="deleteEntitySetName Parameter">Optional parameter that allows users to delete all subscriptions per EntitySetName, ProviderID and NamespaceID. For example, delete FactData subscriptions for ProviderID on SAP Analytics Cloud system.</doc>
					</param>
				</request>
				<response status="204">
					<representation mediaType="application/json"/>
					<representation mediaType="application/xml"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
					<representation mediaType="application/xml"/>
				</response>
				<response status="403">
					<representation mediaType="application/json"/>
					<representation mediaType="application/xml"/>
				</response>
				<response status="404">
					<representation mediaType="application/json"/>
					<representation mediaType="application/xml"/>
				</response>
				<response status="500">
					<representation mediaType="application/json"/>
					<representation mediaType="application/xml"/>
				</response>
			</method>
		</resource>
		<resource path="providers/{namespaceID}/{providerID}/" id="/providers/{namespaceID}/{providerID}/">
			<doc xml:lang="en" title="/providers/{namespaceID}/{providerID}/"/>
			<param name="namespaceID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="namespaceID Parameter">Possible value 'sac' representing SAP Analytics Cloud, 'sac_currency_tables' representing currency tables in SAP Analytics Cloud, or 'sac_unit_conversion' representing unit conversion tables in SAP Analytics Cloud.  In the context of 'sac_unit_conversion' namespace, a provider corresponds to a unit conversion table, or 'sac_public_dimensions' representing public dimensions in SAP Analytics Cloud.</doc>
			</param>
			<param name="providerID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="providerID Parameter">ID of a model,currency table,unit conversion table or public dimension from the SAP Analytics Cloud system.</doc>
			</param>
			<method name="GET" id="getProvider">
				<doc xml:lang="en" title="getProvider">This endpoint returns the service document specifying the entity set names for the provider. Each entity set name will identify a subset of data that can be exported from the selected model.
Returns the service document of the provider.</doc>
				<request/>
				<response status="200">
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
					<representation mediaType="application/json"/>
				</response>
				<response status="404">
					<representation mediaType="application/json"/>
				</response>
				<response status="500">
					<representation mediaType="application/json"/>
				</response>
			</method>
		</resource>
		<resource path="providers/{namespaceID}/{providerID}/$metadata" id="/providers/{namespaceID}/{providerID}/$metadata">
			<doc xml:lang="en" title="/providers/{namespaceID}/{providerID}/$metadata"/>
			<param name="namespaceID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="namespaceID Parameter">Possible value 'sac' representing SAP Analytics Cloud, 'sac_currency_tables' representing currency tables in SAP Analytics Cloud, or 'sac_unit_conversion' representing unit conversion tables in SAP Analytics Cloud, or 'sac_public_dimensions' representing public dimensions SAP Analytics Cloud.</doc>
			</param>
			<param name="providerID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="providerID Parameter">ID of a model, currency table, unit conversion table or a public dimension from the SAP Analytics Cloud system.</doc>
			</param>
			<method name="GET" id="getProviderMetadata">
				<doc xml:lang="en" title="getProviderMetadata">This endpoint returns the OData metadata object for the specified provider.
Returns the metadata of a provider in a namespace. For example, the metadata for planning models on the SAP Analytics Cloud system.</doc>
				<request>
					<param name="$format" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="$format Parameter">The format of the response to return. For example, $format=application/json. If empty defaults to application/xml.</doc>
					</param>
				</request>
				<response status="200">
					<representation mediaType="application/xml"/>
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/xml"/>
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
					<representation mediaType="application/xml"/>
					<representation mediaType="application/json"/>
				</response>
				<response status="404">
					<representation mediaType="application/xml"/>
					<representation mediaType="application/json"/>
				</response>
				<response status="500">
					<representation mediaType="application/xml"/>
					<representation mediaType="application/json"/>
				</response>
			</method>
		</resource>
		<resource path="providers/{namespaceID}/{providerID}/FactData" id="/providers/{namespaceID}/{providerID}/FactData">
			<doc xml:lang="en" title="/providers/{namespaceID}/{providerID}/FactData"/>
			<param name="namespaceID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="namespaceID Parameter">Possible value 'sac' representing SAP Analytics Cloud.</doc>
			</param>
			<param name="providerID" type="xs:string" required="true" default="" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
				<doc xml:lang="en" title="providerID Parameter">ID of a model from the SAP Analytics Cloud system.</doc>
			</param>
			<method name="GET" id="getFactData">
				<doc xml:lang="en" title="getFactData">This endpoint returns the fact data for the specified provider, or extracts the delta when deltaid or externalid are passed.
Returns fact data or performs delta extraction for fact data.</doc>
				<request>
					<param name="$select" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="$select Parameter">Specify columns to select. For example, $select=MyColumn1,MyColumn2.</doc>
					</param>
					<param name="$filter" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="$filter Parameter">Filter result set according to the filter string. For example, MyColumn1 eq 'sac'.</doc>
					</param>
					<param name="$top" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="$top Parameter">Return top X entities of the result set, where X is the value set after $top. For example, $top=5.</doc>
					</param>
					<param name="$skip" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="$skip Parameter">Skip over X amount of entities, where X is the value after $skip. For example, $skip=3.</doc>
					</param>
					<param name="$orderby" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="$orderby Parameter">Order by column by ascending (asc) or descending (desc). For example, MyColumn asc. If left unspecified, columns will be returned in ascending order.</doc>
					</param>
					<param name="pagesize" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="pagesize Parameter">Set the page size.</doc>
					</param>
					<param name="$count" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="$count Parameter">When $count=true is in url, a count of all entities in the selected entity, with filters applied, is displayed in the response (@odata.count).</doc>
					</param>
					<param name="Prefer" type="xs:string" required="false" default="" style="header" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="Prefer Parameter">If included with value 'odata.track-changes', will create a new subscription.</doc>
					</param>
					<param name="deltaid" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="deltaid Parameter">If included with a subscriptionID as value, will extract the delta for that subscription.</doc>
					</param>
					<param name="externalid" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="externalid Parameter">If included with an externalID as value, will extract the delta for the most recent subscription in the chain.</doc>
					</param>
					<param name="allDeltaData" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="allDeltaData Parameter">If included in URL with value set to true, e.g. allDeltaData=true, all delta data captured for FactData is returned.</doc>
					</param>
					<param name="$format" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="$format Parameter">The format of the response to return. For example, $format=application/json, text/csv, or application/json;odata.metadata=full.</doc>
					</param>
					<param name="delimiter" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
						<doc xml:lang="en" title="delimiter Parameter">If included when the format is set to text/csv, will adjust the delimiter to the value passed here.</doc>
					</param>
				</request>
				<response status="200">
					<representation mediaType="application/json"/>
				</response>
				<response status="400">
					<representation mediaType="application/json"/>
				</response>
				<response status="403">
					<representation mediaType="application/json"/>
				</response>
				<response status="404">
					<representation mediaType="application/json"/>
				</response>
				<response status="500">
					<representation mediaType="application/json"/>
				</response>
			</method>
		</resource>
		<resource path="providers/{namespaceID}/{providerID}/FactDataAggregation" id="/providers/{namespaceID}/{providerID}/FactDataAggregation">
